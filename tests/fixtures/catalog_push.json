{
  "$schema": "../schemas/catalog-push.schema.json",
  "contract": "catalog-v2/1",
  "description": "Server SDK conformance for the catalog push API (contracts/06, v2 section; whisperr-go /v1/catalog/*). Every server SDK bundles a byte-identical copy of this file and runs every case: the SDK sends exactly these requests for these calls and returns these results. Item inputs are given in the wire shape (catalog-item-v2.schema.json#/$defs/push_item); each SDK test converts them to its own field naming before calling the SDK. Results are given in the wire shape too. Error bodies are exactly what the server sends: {\"error\":{\"code\",\"message\"}}. A reject with a client-side code (reject_codes.client) carries the message \"<sdk-defined>\": the SDK writes its own message there, and harnesses check only that it is a non-empty string.",
  "limits": {
    "upsert_batch": 500,
    "delete_batch": 1000,
    "max_body_bytes": 2097152
  },
  "reject_codes": {
    "server": [
      "invalid_item",
      "missing_field",
      "invalid_url",
      "url_host_not_allowed",
      "invalid_image_url",
      "invalid_price",
      "invalid_currency",
      "invalid_kind",
      "revision_conflict"
    ],
    "client": [
      "item_too_large"
    ]
  },
